# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data: never commit images (dataset licenses). Only the compact split record is kept; the other manifests
# are regenerated by preprocessing.build_dataset
dataset/*
!dataset/manifests/
dataset/manifests/*
!dataset/manifests/splits.csv

# Trained models: only the five the app needs are committed (each is under GitHub's 100 MB file limit).
# Baselines, the GAN guide and training checkpoints stay local.
models/*
!models/.gitkeep
!models/model.keras
!models/model.json
!models/generator_*to*.keras
!models/generator_*to*.json

# Run artifacts. outputs/eval/ holds the paper's tables, so it is kept; its images contain dataset photos
# and stay local until each dataset's license has been checked
outputs/*
!outputs/.gitkeep
!outputs/eval/
outputs/eval/**/*.jpg
outputs/eval/**/*.png
reports/*
!reports/.gitkeep
database/*.db
database/*.db-journal

# Secrets
kaggle.json
.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Demo sample images come from the datasets: local use only, never committed
static/samples/
